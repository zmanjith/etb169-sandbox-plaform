From 8560f05b0ab791037e8a5e7512413c08223dec72 Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Sat, 19 Sep 2026 04:45:59 +0000
Subject: [PATCH] Fix remaining Checkov findings: probes, seccomp, automount,
 high UID
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

- deployment.yaml: add namespace (Release.Namespace, matches the rest of
  the chart), wire serviceAccountName/automountServiceAccountToken and
  pod-level securityContext onto the pod spec, name the container port
  "http" and attach the already-defined livenessProbe/readinessProbe
  (CKV_K8S_8, CKV_K8S_9, CKV_K8S_29, CKV_K8S_38)
- values.yaml: pullPolicy Always (CKV_K8S_15), serviceAccount.automount
  false (CKV_K8S_38), runAsUser 10001 + seccompProfile RuntimeDefault on
  both pod and container securityContext (CKV_K8S_31, CKV_K8S_40)
- workflow: skip CKV_K8S_21 with justification — every resource already
  namespaces via .Release.Namespace, which resolves correctly at real
  `helm install --namespace <tenant>` time, but Checkov's own internal
  helm-template pass never sets a release namespace so it always renders
  "default" and false-positives

CKV_K8S_43 (image digest) intentionally left open; needs CI-side digest
resolution at build time, out of scope for this pass.
---
 .github/workflows/validate-tenant-pr.yaml        |  8 ++++++++
 app/demo-sandbox-chart/templates/deployment.yaml | 12 +++++++++++-
 app/demo-sandbox-chart/values.yaml               | 14 +++++++++++---
 3 files changed, 30 insertions(+), 4 deletions(-)

diff --git a/.github/workflows/validate-tenant-pr.yaml b/.github/workflows/validate-tenant-pr.yaml
index 96ff32b..362a2cf 100644
--- a/.github/workflows/validate-tenant-pr.yaml
+++ b/.github/workflows/validate-tenant-pr.yaml
@@ -22,3 +22,11 @@ jobs:
               with:
                   directory: app/demo-sandbox-chart
                   framework: helm
+                  # CKV_K8S_21 ("do not use the default namespace") is a false
+                  # positive here: every namespaced resource in this chart
+                  # templates off .Release.Namespace, which is set correctly
+                  # at real deploy time via `helm install --namespace <tenant>`.
+                  # Checkov's own internal `helm template` render never passes
+                  # a release namespace, so it always evaluates to "default"
+                  # regardless of how the chart is actually installed.
+                  skip_check: CKV_K8S_21
diff --git a/app/demo-sandbox-chart/templates/deployment.yaml b/app/demo-sandbox-chart/templates/deployment.yaml
index 9f726bf..76628d0 100644
--- a/app/demo-sandbox-chart/templates/deployment.yaml
+++ b/app/demo-sandbox-chart/templates/deployment.yaml
@@ -2,6 +2,7 @@ apiVersion: apps/v1
 kind: Deployment
 metadata:
   name: {{ .Release.Name }}-{{ .Values.tenantName }}
+  namespace: {{ .Release.Namespace }}
   labels:
     app: {{ .Release.Name }}
     tenant: {{ .Values.tenantName  }}
@@ -16,6 +17,10 @@ spec:
         app: {{ .Release.Name }}
         tenant: {{ .Values.tenantName  }}
     spec:
+      serviceAccountName: {{ include "demo-sandbox-chart.serviceAccountName" . }}
+      automountServiceAccountToken: {{ .Values.serviceAccount.automount }}
+      securityContext:
+        {{- toYaml .Values.podSecurityContext | nindent 8 }}
       containers:
         - name: {{ .Chart.Name }}
           image: "{{ .Values.image.repository }}:{{ .Values.image.tag }}"
@@ -23,6 +28,11 @@ spec:
           securityContext:
             {{- toYaml .Values.securityContext | nindent 12 }}
           ports:
-            - containerPort: 5000
+            - name: http
+              containerPort: 5000
+          livenessProbe:
+            {{- toYaml .Values.livenessProbe | nindent 12 }}
+          readinessProbe:
+            {{- toYaml .Values.readinessProbe | nindent 12 }}
           resources:
             {{- toYaml .Values.resources | nindent 12 }}
diff --git a/app/demo-sandbox-chart/values.yaml b/app/demo-sandbox-chart/values.yaml
index 5e52812..4bd1b49 100644
--- a/app/demo-sandbox-chart/values.yaml
+++ b/app/demo-sandbox-chart/values.yaml
@@ -11,7 +11,7 @@ replicaCount: 1
 image:
   repository: demo-sandbox-app
   # This sets the pull policy for images.
-  pullPolicy: IfNotPresent
+  pullPolicy: Always
   # Overrides the image tag whose default is the chart appVersion.
   tag: "v1"
 
@@ -26,7 +26,7 @@ serviceAccount:
   # Specifies whether a service account should be created
   create: true
   # Automatically mount a ServiceAccount's API credentials?
-  automount: true
+  automount: false
   # Annotations to add to the service account
   annotations: {}
   # The name of the service account to use.
@@ -40,13 +40,21 @@ podAnnotations: {}
 # For more information checkout: https://kubernetes.io/docs/concepts/overview/working-with-objects/labels/
 podLabels: {}
 
-podSecurityContext: {}
+podSecurityContext:
+  runAsNonRoot: true
+  # High UID avoids colliding with host UIDs (CKV_K8S_40).
+  runAsUser: 10001
+  seccompProfile:
+    type: RuntimeDefault
   # fsGroup: 2000
 
 securityContext:
   allowPrivilegeEscalation: false
   readOnlyRootFilesystem: true
   runAsNonRoot: true
+  runAsUser: 10001
+  seccompProfile:
+    type: RuntimeDefault
   capabilities:
     drop:
       - ALL
-- 
2.43.0

